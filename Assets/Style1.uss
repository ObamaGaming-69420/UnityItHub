:root {
}

.ButtonStyles {
    align-self: center;
    justify-content: space-around;
    align-items: center;
    font-size: 30px;
    color: rgb(0, 0, 0);
    background-color: rgb(86, 155, 152);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-left-radius: 30px;
    border-top-right-radius: 30px;
    border-bottom-right-radius: 30px;
    border-bottom-left-radius: 30px;
    border-left-color: rgb(0, 0, 255);
    border-right-color: rgb(0, 0, 255);
    border-top-color: rgb(0, 0, 255);
    border-bottom-color: rgb(0, 0, 255);
    width: 252px;
    height: 59px;
}

.ButtonStyles:hover {
    align-self: center;
    justify-content: space-around;
    align-items: center;
    font-size: 30px;
    color: rgb(0, 0, 0);
    background-color: rgb(0, 240, 229);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-left-radius: 30px;
    border-top-right-radius: 30px;
    border-bottom-right-radius: 30px;
    border-bottom-left-radius: 30px;
    border-left-color: rgb(0, 0, 255);
    border-right-color: rgb(0, 0, 255);
    border-top-color: rgb(0, 0, 255);
    border-bottom-color: rgb(0, 0, 255);
    width: 253px;
    height: 60px;
}



.ButtonStyles:active {
    align-self: center;
    justify-content: space-around;
    align-items: center;
    font-size: 30px;
    color: rgb(0, 0, 0);
    background-color: rgb(174, 243, 240);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-left-radius: 30px;
    border-top-right-radius: 30px;
    border-bottom-right-radius: 30px;
    border-bottom-left-radius: 30px;
    border-left-color: rgb(0, 0, 255);
    border-right-color: rgb(0, 0, 255);
    border-top-color: rgb(0, 0, 255);
    border-bottom-color: rgb(0, 0, 255);
    width: 255px;
    height: 62px;
}
